datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
  RECRUITER
}

enum Visibility {
  PUBLIC
  CONNECTIONS
  PRIVATE
}

enum CompanyRole {
  OWNER
  ADMIN
  RECRUITER
  EMPLOYEE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum EmploymentType {
  ON_SITE
  HYBRID
  REMOTE
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEWING
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  LIKE
  COMMENT
  CONNECTION_REQUEST
  CONNECTION_ACCEPT
  MESSAGE
  JOB_ALERT
  MENTION
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum InterviewMode {
  ONLINE
  OFFLINE
  PHONE
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum ReportTargetType {
  USER
  POST
  COMMENT
  JOB
  COMPANY
}

enum RecommendationAction {
  CLICKED
  DISMISSED
  APPLIED
  SAVED
  CONNECTED
}

enum NotificationEntityType {
  USER
  POST
  COMMENT
  JOB
  COMPANY
  MESSAGE
  CONNECTION
}

// ==========================================
// IDENTITY & PROFILE
// ==========================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole @default(USER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Auth
  sessions UserSession[]

  // Profile relations
  profile     Profile?
  experiences Experience[]
  education   Education[]
  skills      UserSkill[]
  projects    Project[]

  // Social
  posts     Post[]
  comments  Comment[]
  likes     Like[]
  follows   Follow[]  @relation("Follower")
  followers Follow[]  @relation("Following")

  // Connections
  sentConnections     Connection[] @relation("SentConnections")
  receivedConnections Connection[] @relation("ReceivedConnections")

  // Company
  companyMembers CompanyMember[]

  // Jobs
  applications Application[]
  savedJobs    SavedJob[]
  recruiter    Recruiter?

  // Messaging
  conversations ConversationMember[]
  messages      Message[]

  // Notifications
  notifications Notification[]

  // Recommendations
  recommendationFeedbacks RecommendationFeedback[]

  // Search
  searchHistories SearchHistory[]

  // Admin
  auditLogs      AuditLog[]
  reportsCreated Report[]   @relation("Reporter")
  followedCompanies CompanyFollower[]
  companyRequests CompanyCreationRequest[] @relation("CompanyRequester")
  reviewedRequests CompanyCreationRequest[] @relation("CompanyReviewer")
  shares           Share[]

  isSuspended  Boolean  @default(false) @map("is_suspended")

  @@map("users")
}

model Profile {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @unique @db.Uuid
  headline  String?
  bio       String?
  location  String?
  resumeUrl String?
  website   String?
  avatarUrl String? @map("avatar_url")
  coverUrl  String? @map("cover_url")
  certificates Certificate[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  device    String?
  ipAddress String?  @map("ip_address")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("user_sessions")
}

// ==========================================
// PROFILE ENTITIES
// ==========================================

model Experience {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  companyId   String?        @db.Uuid
  companyName String         @map("company_name")
  title       String
  location    String?
  type        EmploymentType @default(ON_SITE)
  isCurrent   Boolean        @default(false) @map("is_current")
  startDate   DateTime       @map("start_date") @db.Date
  endDate     DateTime?      @map("end_date") @db.Date
  description String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("experiences")
}

model Education {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  school       String
  degree       String?
  fieldOfStudy String?   @map("field_of_study")
  grade        String?
  activities   String?
  description  String?
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("educations")
}

model Skill {
  id    String      @id @default(uuid()) @db.Uuid
  name  String      @unique
  users UserSkill[]
  jobs  JobSkill[]

  @@map("skills")
}

model UserSkill {
  userId  String @db.Uuid
  skillId String @db.Uuid

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@map("user_skills")
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  title       String
  description String
  projectUrl  String?   @default("") @map("project_url")
  repoUrl     String?   @default("") @map("repo_url")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("projects")
}

// ==========================================
// COMPANY
// ==========================================

model Company {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  tagline     String?
  description String?
  slug        String   @unique
  website     String?
  logoUrl     String?  @map("logo_url")
  industry    String?
  isVerified  Boolean  @default(false) @map("is_verified")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  employeeCount String?  @map("employee_count")
  foundedYear   Int?     @map("founded_year")

  members     CompanyMember[]
  jobs        Job[]
  posts       Post[]
  experiences Experience[]
  recruiters  Recruiter[]
  departments Department[]
  followers   CompanyFollower[]
  isSuspended Boolean  @default(false) @map("is_suspended")

  @@map("companies")
}

model CompanyMember {
  companyId String      @db.Uuid
  userId    String      @db.Uuid
  role      CompanyRole @default(EMPLOYEE)
  title     String?
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([companyId, userId])
  @@index([userId])
  @@map("company_members")
}

// ==========================================
// CONNECTIONS & SOCIAL
// ==========================================

model Connection {
  id         String           @id @default(uuid()) @db.Uuid
  senderId   String           @map("sender_id") @db.Uuid
  receiverId String           @map("receiver_id") @db.Uuid
  status     ConnectionStatus @default(PENDING)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  sender   User @relation("SentConnections", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@map("connections")
}

model Follow {
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("follows")
}

model Post {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  companyId  String?    @db.Uuid
  content    String
  imageUrl   String?    @map("image_url")
  visibility Visibility @default(PUBLIC)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  media    PostMedia[]
  comments Comment[]
  likes    Like[]
  shares   Share[]

  @@index([userId])
  @@index([companyId])
  @@index([createdAt])
  @@map("posts")
}

model PostMedia {
  id     String    @id @default(uuid()) @db.Uuid
  postId String    @db.Uuid
  url    String
  type   MediaType

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_media")
}

model Comment {
  id              String   @id @default(uuid()) @db.Uuid
  postId          String   @db.Uuid
  userId          String   @db.Uuid
  parentCommentId String?  @map("parent_comment_id") @db.Uuid
  content         String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([postId])
  @@index([parentCommentId])
  @@map("comments")
}

model Like {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("likes")
}

// ==========================================
// JOBS & APPLICATIONS
// ==========================================

model Job {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  recruiterId String    @db.Uuid
  title       String
  description String
  location    String
  publishedAt DateTime?

  experienceLevel String?   @map("experience_level")
  deadline        DateTime? @db.Timestamptz
  vacancies       Int?
  benefits        String?

  salaryMin Int?    @map("salary_min")
  salaryMax Int?    @map("salary_max")
  currency  String? @default("USD")

  type           JobType        @default(FULL_TIME)
  employmentType EmploymentType @default(ON_SITE)
  isClosed       Boolean        @default(false) @map("is_closed")
  isSuspended    Boolean        @default(false) @map("is_suspended")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruiter Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  skills       JobSkill[]
  applications Application[]
  savedBy      SavedJob[]

  @@index([companyId])
  @@index([createdAt])
  @@index([publishedAt])
  @@index([location])
  @@index([type])
  @@index([employmentType])
  @@index([isClosed])
  @@map("jobs")
}

model JobSkill {
  jobId   String @db.Uuid
  skillId String @db.Uuid

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@map("job_skills")
}

model SavedJob {
  userId    String   @db.Uuid
  jobId     String   @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@map("saved_jobs")
}

model Application {
  id             String            @id @default(uuid()) @db.Uuid
  jobId          String            @db.Uuid
  userId         String            @db.Uuid
  resumeUrl      String            @map("resume_url")
  coverLetter    String?           @map("cover_letter")
  expectedSalary Int?              @map("expected_salary")
  noticePeriod   String?           @map("notice_period")
  status         ApplicationStatus @default(PENDING)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  interviews Interview[]

  @@index([jobId, status])
  @@index([userId])
  @@map("applications")
}

model Interview {
  id            String           @id @default(uuid()) @db.Uuid
  applicationId String           @db.Uuid
  mode          InterviewMode?
  status        InterviewStatus?
  location      String?
  scheduledAt   DateTime         @map("scheduled_at") @db.Timestamptz
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("interviews")
}

// ==========================================
// MESSAGING
// ==========================================

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  isGroup   Boolean  @default(false) @map("is_group")
  title     String?
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  members  ConversationMember[]
  messages Message[]

  @@map("conversations")
}

model ConversationMember {
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  lastReadAt     DateTime @default(now()) @map("last_read_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  senderId       String    @db.Uuid
  content        String
  type           String?   @default("TEXT")
  replyToId      String?   @db.Uuid
  isEdited       Boolean   @default(false) @map("is_edited")
  deletedAt      DateTime? @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?            @relation("MessageReplies", fields: [replyToId], references: [id])
  replies      Message[]           @relation("MessageReplies")
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id        String    @id @default(uuid()) @db.Uuid
  messageId String    @db.Uuid
  fileUrl   String    @map("file_url")
  fileType  MediaType @map("file_type")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

// ==========================================
// NOTIFICATIONS
// ==========================================

model Notification {
  id         String                  @id @default(uuid()) @db.Uuid
  userId     String                  @db.Uuid
  type       NotificationType
  title      String?
  content    String
  link       String?
  imageUrl   String?                 @map("image_url")
  entityId   String?                 @map("entity_id")
  entityType NotificationEntityType? @map("entity_type")
  isRead     Boolean                 @default(false) @map("is_read")
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ==========================================
// RECOMMENDATIONS
// ==========================================

model RecommendationFeedback {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  targetId  String               @db.Uuid
  action    RecommendationAction
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recommendation_feedbacks")
}

// ==========================================
// SEARCH & ADMIN
// ==========================================

model SearchHistory {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  query       String
  resultCount Int?     @map("result_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("search_histories")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  details   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Report {
  id         String           @id @default(uuid()) @db.Uuid
  reporterId String           @db.Uuid
  targetType ReportTargetType @map("target_type")
  targetId   String           @db.Uuid
  reason     String
  status     ReportStatus     @default(PENDING)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([status])
  @@map("reports")
}

model Recruiter {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  title     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs    Job[]

  @@index([userId])
  @@index([companyId])
  @@map("recruiters")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("departments")
}

model CompanyFollower {
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([companyId, userId])
  @@map("company_followers")
}

model Certificate {
  id           String    @id @default(uuid()) @db.Uuid
  profileId    String    @map("profile_id") @db.Uuid
  name         String
  issuer       String
  issueDate    DateTime? @map("issue_date") @db.Timestamptz
  expiryDate   DateTime? @map("expiry_date") @db.Timestamptz
  credentialId String?   @map("credential_id")
  url          String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

// ==========================================
// COMPANY REQUESTS
// ==========================================

model CompanyCreationRequest {
  id              String        @id @default(uuid()) @db.Uuid
  requesterId     String        @map("requester_id") @db.Uuid
  companyName     String        @map("company_name")
  slug            String        @unique
  website         String?
  industry        String?
  size            String?
  headquarters    String?
  description     String?
  logoUrl         String?       @map("logo_url")
  coverUrl        String?       @map("cover_url")
  status          RequestStatus @default(PENDING)
  rejectionReason String?       @map("rejection_reason")
  reviewedById    String?       @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?     @map("reviewed_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  requester User  @relation("CompanyRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer  User? @relation("CompanyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([requesterId])
  @@index([status])
  @@map("company_creation_requests")
}

model Share {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("shares")
}
